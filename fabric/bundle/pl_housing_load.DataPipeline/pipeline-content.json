{
  "properties": {
    "description": "Load one province-year delivery: build + stage (notebook), then QA gate and warehouse load (stored procedure). Generated by `housing-fabric bundle`.",
    "parameters": {
      "source_system": {
        "type": "string",
        "defaultValue": "ON"
      },
      "reference_year": {
        "type": "int",
        "defaultValue": 2025
      },
      "metadata_release": {
        "type": "string",
        "defaultValue": "current"
      },
      "mode": {
        "type": "string",
        "defaultValue": "validate"
      }
    },
    "concurrency": 1,
    "activities": [
      {
        "name": "Build staging",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NOTEBOOK_ID>",
          "workspaceId": "<WORKSPACE_ID>",
          "parameters": {
            "source_system": {
              "value": {
                "value": "@pipeline().parameters.source_system",
                "type": "Expression"
              },
              "type": "string"
            },
            "reference_year": {
              "value": {
                "value": "@pipeline().parameters.reference_year",
                "type": "Expression"
              },
              "type": "int"
            },
            "metadata_release": {
              "value": {
                "value": "@pipeline().parameters.metadata_release",
                "type": "Expression"
              },
              "type": "string"
            },
            "mode": {
              "value": {
                "value": "@pipeline().parameters.mode",
                "type": "Expression"
              },
              "type": "string"
            },
            "run_id": {
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      },
      {
        "name": "Load warehouse",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "Build staging",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "[audit].[usp_load_run]",
          "storedProcedureParameters": {
            "source_system": {
              "value": {
                "value": "@pipeline().parameters.source_system",
                "type": "Expression"
              },
              "type": "String"
            },
            "reference_year": {
              "value": {
                "value": "@pipeline().parameters.reference_year",
                "type": "Expression"
              },
              "type": "Int32"
            },
            "metadata_release": {
              "value": {
                "value": "@pipeline().parameters.metadata_release",
                "type": "Expression"
              },
              "type": "String"
            },
            "mode": {
              "value": {
                "value": "@pipeline().parameters.mode",
                "type": "Expression"
              },
              "type": "String"
            },
            "run_id": {
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              },
              "type": "String"
            }
          }
        },
        "linkedService": {
          "name": "wh_housing",
          "properties": {
            "annotations": [],
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "<WAREHOUSE_SQL_ENDPOINT>",
              "artifactId": "<WAREHOUSE_ID>",
              "workspaceId": "<WORKSPACE_ID>"
            }
          }
        }
      }
    ]
  }
}
